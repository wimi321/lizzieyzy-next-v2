{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window: application commands, file selection dialogs and closing itself (文件 → 退出).",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "allow-open-bytes",
    "allow-open-path",
    "allow-save",
    "allow-play",
    "allow-step",
    "allow-go-to",
    "allow-undo",
    "allow-redo",
    "allow-variation-tree",
    "allow-preview-variation",
    "allow-set-pondering",
    "allow-start-board-sync",
    "allow-stop-board-sync",
    "allow-board-sync-status",
    "allow-start-whole-game-analysis",
    "allow-pause-whole-game-analysis",
    "allow-resume-whole-game-analysis",
    "allow-cancel-whole-game-analysis",
    "allow-whole-game-progress",
    "allow-whole-game-result",
    "allow-problem-moves",
    "allow-set-move-rank-settings",
    "allow-strength-estimate",
    "allow-configure-engine",
    "allow-detect-engines",
    "allow-auto-configure-engine",
    "allow-try-configure-engine",
    "allow-fox-search",
    "allow-fox-next-page",
    "allow-fox-open-game",
    "allow-fox-clear-history",
    "allow-settings",
    "allow-subscribe",
    "allow-unsubscribe",
    "core:window:allow-close",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
