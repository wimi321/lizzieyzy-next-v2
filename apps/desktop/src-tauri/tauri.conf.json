{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LizzieYzy Next 2",
  "version": "0.1.0",
  "identifier": "io.github.wimi321.lizzieyzy.next2",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LizzieYzy Next 2",
        "width": 1280,
        "height": 820,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "fileAssociations": [
      {
        "ext": ["sgf"],
        "name": "SGF",
        "description": "Smart Game Format",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/x-go-sgf"
      },
      {
        "ext": ["gib"],
        "name": "GIB",
        "description": "Tygem Go game record",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/x-go-gib"
      }
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/mime/packages/io.github.wimi321.lizzieyzy.next2.xml": "game-records.xml"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/mime/packages/io.github.wimi321.lizzieyzy.next2.xml": "game-records.xml"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/mime/packages/io.github.wimi321.lizzieyzy.next2.xml": "game-records.xml"
        }
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../../../resources/katago/analysis.cfg": "katago/analysis.cfg"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/wimi321/lizzieyzy-next-v2/releases/latest/download/latest.json"
      ],
      "pubkey": "",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
